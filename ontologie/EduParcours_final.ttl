    rdfs:label "est évalué par"@fr ;
    rdfs:domain edu:Cours ;
    rdfs:range edu:Evaluation ;
    rdfs:subPropertyOf edu:relationRessource ;
    owl:inverseOf edu:evalue .

edu:estInscritAuModule a owl:ObjectProperty ;
    rdfs:label "est inscrit au module"@fr ;
    rdfs:domain edu:Apprenant ;
    rdfs:range edu:Module ;
    rdfs:subPropertyOf edu:relationApprenant ;
    owl:inverseOf edu:accueilleInscrit ;
    owl:propertyChainAxiom ( edu:estInscritA edu:composeDe ) .

edu:estSousCompetenceDe a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "est sous-compétence de"@fr ;
    rdfs:domain edu:Competence ;
