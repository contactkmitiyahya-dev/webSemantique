@prefix edu: <http://www.eduparcours.org/ontologie#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.eduparcours.org/ontologie> a owl:Ontology ;
    rdfs:label "EduParcours"@fr ;
    rdfs:comment "Ontologie de l'Éducation et de la Formation (développement web) : compétences, programmes, prérequis et parcours."@fr ;
    owl:versionInfo "1.0 - version finale" .

edu:ApprenantFullStackReady a owl:Class ;
    rdfs:label "Apprenant Full-Stack ready"@fr ;
    rdfs:comment "Apprenant maîtrisant React et Node.js (classé par le raisonneur)."@fr ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( edu:Apprenant [ a owl:Restriction ;
                        owl:onProperty edu:possedeCompetence ;
                        owl:someValuesFrom edu:CompetenceReact ] [ a owl:Restriction ;
                        owl:onProperty edu:possedeCompetence ;
                        owl:someValuesFrom edu:CompetenceNodeJS ] ) ] .

edu:ApprenantQualifieFrontend a owl:Class ;
    rdfs:label "Apprenant qualifie front-end"@fr ;
    rdfs:comment "Apprenant possédant à la fois HTML et CSS (classé par le raisonneur)."@fr ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( edu:Apprenant [ a owl:Restriction ;
                        owl:hasValue edu:Comp_HTML ;
                        owl:onProperty edu:possedeCompetence ] [ a owl:Restriction ;
                        owl:hasValue edu:Comp_CSS ;
                        owl:onProperty edu:possedeCompetence ] ) ] .

edu:Certificat_Frontend a edu:CertificationFrontend,
        owl:NamedIndividual ;
    rdfs:label "Certificat Développeur Front-end"@fr ;
    edu:certificationRequiertModule edu:Module_CSS,
        edu:Module_HTML,
        edu:Module_JavaScript,
        edu:Module_React ;
    edu:delivreeParOrganisme edu:EduParcours_Academie ;
    edu:dureeValiditeAns 4 .

edu:CertificationDataAnalyst a owl:Class ;
    rdfs:label "Certification data analyst"@fr ;
    rdfs:subClassOf edu:CertificationDonnees .

edu:Design_UX a edu:UXDesign,
        owl:NamedIndividual ;
    rdfs:label "Design UX"@fr ;
    edu:intitule "Design UX"^^xsd:string .

edu:FormateurPolyvalent a owl:Class ;
    rdfs:label "Formateur polyvalent"@fr ;
    rdfs:comment "Formateur enseignant au moins 3 cours (classé par le raisonneur)."@fr ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( edu:Formateur [ a owl:Restriction ;
                        owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
                        owl:onClass edu:Cours ;
                        owl:onProperty edu:enseigne ] ) ] .

edu:FormationAccessibleDebutant a owl:Class ;
    rdfs:label "Formation accessible débutant"@fr ;
    rdfs:comment "Formation dont tous les modules sont de niveau Débutant (classé par le raisonneur)."@fr ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( edu:Formation [ a owl:Restriction ;
                        owl:allValuesFrom [ a owl:Restriction ;
                                owl:hasValue "Débutant"^^xsd:string ;
                                owl:onProperty edu:niveauDifficulte ] ;
                        owl:onProperty edu:composeDe ] ) ] .

edu:Mme_Hamrouni a edu:GestionnaireInscription,
        owl:NamedIndividual ;
    rdfs:label "Mme Hamrouni"@fr ;
    edu:email "salma.hamrouni@eduparcours.org"^^xsd:string ;
    edu:nom "Hamrouni"^^xsd:string ;
    edu:prenom "Salma"^^xsd:string .

edu:ModuleAvecPrerequis a owl:Class ;
    rdfs:label "Module avec prerequis"@fr ;
    rdfs:comment "Module ayant au moins un prérequis (classé par le raisonneur)."@fr ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( edu:Module [ a owl:Restriction ;
                        owl:onProperty edu:aPourPrerequis ;
                        owl:someValuesFrom edu:Module ] ) ] .

edu:Quiz_Docker a edu:QuizEnPresentiel,
        owl:NamedIndividual ;
    rdfs:label "Quiz Docker"@fr ;
    edu:coefficient 1.0 ;
    edu:dateEvaluation "2026-12-05T00:00:00"^^xsd:dateTime ;
    edu:evaluationDuModule edu:Module_Deploiement ;
    edu:evalue edu:Cours_Docker ;
    edu:noteMinimale 10.0 ;
    edu:porteSurCompetence edu:Comp_Deploiement .

edu:Rattrapage_JavaScript a edu:ExamenRattrapage,
        owl:NamedIndividual ;
    rdfs:label "Examen de rattrapage JavaScript"@fr ;
    edu:coefficient 2.0 ;
    edu:dateEvaluation "2026-12-15T00:00:00"^^xsd:dateTime ;
    edu:evaluationDuModule edu:Module_JavaScript ;
    edu:evalue edu:Cours_JavaScript ;
    edu:noteMinimale 10.0 ;
    edu:porteSurCompetence edu:Comp_JavaScript .

edu:Rim a edu:ProfessionnelEnMiseANiveau,
        owl:NamedIndividual ;
    rdfs:label "Rim"@fr ;
    edu:dateInscription "2026-10-01T00:00:00"^^xsd:dateTime ;
    edu:dateNaissance "1992-12-05T00:00:00"^^xsd:dateTime ;
    edu:email "rim@eduparcours.org"^^xsd:string ;
    edu:estEncadrePar edu:Mme_Jebali ;
    edu:estInscritA edu:Formation_Angular ;
    edu:estInscritAuModule edu:Module_Angular ;
    edu:maitriseTechnologie edu:Tech_Angular,
        edu:Tech_React ;
    edu:niveauEtudes "Master"^^xsd:string ;
    edu:nom "Mansour"^^xsd:string ;
    edu:passeEvaluation edu:Quiz_Angular ;
    edu:possedeCompetence edu:Comp_Angular,
        edu:Comp_CSS,
        edu:Comp_HTML,
        edu:Comp_JavaScript,
        edu:Comp_React ;
    edu:prenom "Rim"^^xsd:string ;
    edu:suitParcours edu:Parcours_Angular_Renforce .

edu:Simulateur_Reseau a edu:SimulateurReseau,
        owl:NamedIndividual ;
    rdfs:label "Simulateur réseau"@fr ;
    edu:langue "fr"^^xsd:string ;
    edu:urlRessource "https://example.org/outils/reseau"^^xsd:string .

edu:Tech_Vue a edu:FrameworkVue,
        owl:NamedIndividual ;
    rdfs:label "Vue.js"@fr .

edu:aPourSuivantDirect a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "a pour suivant direct"@fr ;
    rdfs:domain edu:Module ;
    rdfs:range edu:Module ;
    rdfs:subPropertyOf edu:relationProgramme ;
    owl:inverseOf edu:aPourPrecedentDirect .

edu:administreFormation a owl:ObjectProperty ;
    rdfs:label "administre formation"@fr ;
    rdfs:domain edu:ResponsableFormation ;
    rdfs:range edu:Formation ;
    rdfs:subPropertyOf edu:relationInstitutionnelle ;
    owl:inverseOf edu:estAdministreePar .

edu:ageActuel a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "âge actuel"@fr ;
    rdfs:comment "Propriété dérivée : à calculer à partir de edu:dateNaissance (non stockée)."@fr ;
    rdfs:domain edu:Personne ;
    rdfs:range xsd:integer .

edu:animeParcours a owl:ObjectProperty ;
    rdfs:label "anime parcours"@fr ;
    rdfs:domain edu:Formateur ;
    rdfs:range edu:Parcours ;
    rdfs:subPropertyOf edu:relationInstitutionnelle ;
    owl:inverseOf edu:estAnimePar .

edu:certificationRequiertModule a owl:ObjectProperty ;
    rdfs:label "certification requiert module"@fr ;
    rdfs:domain edu:Certification ;
    rdfs:range edu:Module ;
    rdfs:subPropertyOf edu:relationProgramme ;
    owl:inverseOf edu:estRequisPourCertification .

edu:coefficient a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "coefficient"@fr ;
    rdfs:domain edu:Evaluation ;
    rdfs:range xsd:decimal .

edu:competenceSurTechnologie a owl:ObjectProperty ;
    rdfs:label "compétence sur technologie"@fr ;
    rdfs:domain edu:Competence ;
    rdfs:range edu:Technologie ;
    rdfs:subPropertyOf edu:relationCompetence ;
    owl:inverseOf edu:estMobiliseePar .

edu:coutFormation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "coût de la formation"@fr ;
    rdfs:domain edu:Formation ;
    rdfs:range xsd:decimal .

