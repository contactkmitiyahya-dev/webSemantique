edu:Cours a owl:Class ;
    rdfs:label "Cours"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty edu:enseignePar ;
            owl:someValuesFrom edu:Formateur ],
        [ a owl:Restriction ;
            owl:onProperty edu:utiliseTechnologie ;
            owl:someValuesFrom edu:Technologie ],
        [ a owl:Restriction ;
            owl:onProperty edu:developpeCompetence ;
            owl:someValuesFrom edu:Competence ],
        edu:EntitePedagogique .

edu:Module_JavaScript a edu:ModuleJavaScript,
        owl:NamedIndividual ;
    rdfs:label "Module JavaScript"@fr ;
    edu:aPourPrerequis edu:Module_HTML ;
    edu:aPourSuivantDirect edu:Module_React ;
    edu:contientCours edu:Cours_JavaScript ;
    edu:dureeHeures 40 ;
    edu:intitule "Module JavaScript"^^xsd:string ;
    edu:niveauDifficulte "Intermédiaire"^^xsd:string ;
    edu:requiertCompetence edu:Comp_HTML .

edu:Formation a owl:Class ;
    rdfs:label "Formation"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty edu:composeDe ;
            owl:someValuesFrom edu:Module ],
        [ a owl:Restriction ;
            owl:onProperty edu:appartientAuDomaine ;
            owl:someValuesFrom edu:Domaine ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty edu:meneA ],
        edu:EntitePedagogique .

edu:Competence a owl:Class ;
    rdfs:label "Compétence"@fr ;
    rdfs:comment "Ce qu'un apprenant sait faire."@fr .

edu:Apprenant a owl:Class ;
    rdfs:label "Apprenant"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "3"^^xsd:nonNegativeInteger ;
            owl:onProperty edu:estInscritA ],
        edu:Personne .

edu:Module a owl:Class ;
    rdfs:label "Module"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty edu:contientCours ],
        edu:EntitePedagogique .

